OPENWEATHER_API_KEY=your_openweathermap_api_key_here
PORT=3000

# Admin portal (moderation of community pollution-source reports)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_deploying
# Optional: signs admin session tokens. Generated once, keep it private.
AUTH_SECRET=

# Optional: durable storage for submissions on read-only hosts (e.g. Vercel).
# Leave blank to use the bundled JSON file at data/submissions.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_SUBMISSIONS_KEY=aqis:submissions